{
  "name": "yesid-login",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "test": "bun test tests",
    "test:e2e": "bun e2e/run.ts",
    "check": "tsc --noEmit && svelte-check --tsconfig login/tsconfig.json",
    "copy-editor": "bun scripts/copy-editor.ts",
    "schema": "bun scripts/generate-schema.ts",
    "deploy": "bun run copy-editor && bun run build:login && bun test tests && bun run check && bun run test:e2e && wrangler deploy",
    "build:login": "node scripts/build-login.mjs",
    "og": "bun scripts/build-og.ts",
    "favicon": "bun scripts/build-favicon.ts",
    "deploy:staging": "bun run copy-editor && bun run build:login && bun test tests && bun run check && bun run test:e2e && wrangler deploy --env staging",
    "release:staging": "op run --env-file=deploy.env -- bun run deploy:staging",
    "release": "op run --env-file=deploy.env -- bun run deploy",
    "deploy:now": "bun run copy-editor && bun run build:login && wrangler deploy --env=\"\"",
    "deploy:now:staging": "bun run copy-editor && bun run build:login && wrangler deploy --env staging",
    "release:now": "op run --env-file=deploy.env -- bun run deploy:now",
    "release:now:staging": "op run --env-file=deploy.env -- bun run deploy:now:staging"
  },
  "dependencies": {
    "@sveltia/cms": "0.261.0",
    "@yesid/analytics": "https://github.com/yesid-dev/yesid.design/releases/download/v0.42.0-rc.2/yesid-analytics-0.42.0-rc.2.tgz",
    "@yesid/motion": "https://github.com/yesid-dev/yesid.design/releases/download/v0.42.0-rc.2/yesid-motion-0.42.0-rc.2.tgz",
    "@yesid/seo-kit": "https://github.com/yesid-dev/yesid.design/releases/download/v0.42.0-rc.2/yesid-seo-kit-0.42.0-rc.2.tgz",
    "@yesid/tokens": "https://github.com/yesid-dev/yesid.design/releases/download/v0.42.0-rc.2/yesid-tokens-0.42.0-rc.2.tgz",
    "@yesid/ui": "https://github.com/yesid-dev/yesid.design/releases/download/v0.42.0-rc.2/yesid-ui-0.42.0-rc.2.tgz",
    "better-auth": "1.7.18",
    "graphql": "17.1.0",
    "satori": "0.33.5",
    "svelte": "5.57.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@resvg/resvg-js": "2.6.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "playwright-core": "1.62.0",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "wrangler": "^4.158.0"
  }
}
