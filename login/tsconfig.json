{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"], "strict": true,
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["./**/*.ts", "./**/*.svelte"]
}
